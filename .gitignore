.cache/
output/
output_*/
# 凭据：飞书 webhook URL 与签名密钥，绝不入库
.env
# 事件历史库：派生数据，会持续增长，需自行备份
data/
__pycache__/
*.pyc
.venv/
*_run.log
.pytest_cache/
# 每日任务日志：会持续累积，且内容可从事件库与输出目录复原
logs/
# gh CLI 在工作目录下写的设备标识，属本机状态
.local/
# 本机权限白名单与 worktree 状态，对他人无意义
.claude/settings.local.json
.claude/worktrees/
# 打包产物
build/
dist/
*.egg-info/
# superpowers 技能在顶层生成的临时计划与 spec。各期的正式文档归档在
# docs/第N期工程/ 下并随仓库公开 —— 里面的姓名邮箱本就是开源社区的公开
# 信息，且这批文档正是表彰名单的依据。
/docs/superpowers/
